{
  "name": "blockid-web",
  "version": "3.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "cache:purge": "bash scripts/purge-cloudflare-cache.sh",
    "lint": "eslint",
    "lint:reseller": "node scripts/ci/reseller-lints.mjs",
    "lint:audit": "node scripts/ci/audit-lint.mjs",
    "lint:docs-plans-secrets": "node scripts/ci/docs-plans-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e --reporter=list",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test tests/e2e/**/smoke*.spec.ts --reporter=list",
    "e2e:a11y": "playwright test tests/e2e/a11y/ --reporter=list",
    "e2e:post-deploy": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-https://blockid.au} playwright test tests/e2e/smoke/post-deploy.spec.ts --reporter=list",
    "tour:capture": "node ../scripts/tour-capture.mjs",
    "tour:verify": "node ../scripts/tour-verify.mjs",
    "video:preview": "remotion studio ../remotion/index.tsx",
    "video:render": "remotion render ../remotion/index.tsx HowItWorks public/media/how-it-works.mp4 --overwrite --crf 28 --props {}"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@google/generative-ai": "^0.24.1",
    "@react-pdf/renderer": "^4.5.1",
    "@remotion/bundler": "^4.0.463",
    "@remotion/cli": "^4.0.463",
    "@remotion/player": "^4.0.463",
    "@remotion/renderer": "^4.0.463",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.105.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "16.2.5",
    "nodemailer": "^8.0.7",
    "openai": "^6.38.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remotion": "^4.0.463",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
