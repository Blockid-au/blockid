# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit populated env files)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.next-backup/
# G30 deployment runtime locators; authoritative origin state is kept separately.
/.g30-candidate.pid
/.g30-candidate-unit

# zero-downtime release dirs (immutable per-build copies the live server runs from)
/releases/
.next-current
.next-previous
/.next-candidate

# Playwright output — never commit trace artefacts.
test-results/
playwright-report/
playwright-report-live-qa/
content/reports/ai-last-report.json
content/reports/ai-provider-status.json
# G15 runtime outputs (review 2026-09-18)
content/reports/error-digest.jsonl
content/reports/error-digest-state.json
content/reports/latency.jsonl
content/reports/latency-state.json
content/reports/test-flakes.jsonl
content/reports/ops-alert-email-state.json
content/reports/watchdog-restarts.jsonl
# G16-C pilot runtime outputs (the ledger content/pilots.json IS committed)
content/reports/pilot-applications.jsonl
content/reports/pilots-journal.jsonl
content/reports/funnel-daily.jsonl
content/reports/funnel-latest.json
content/reports/link-check.jsonl
content/reports/link-check-latest.json
content/reports/page-sweep.jsonl
content/reports/page-sweep-latest.json
content/reports/stripe-price-audit-latest.json
# G19-S46 report-quality telemetry (runtime, appended per pipeline run)
content/reports/tbr-quality.jsonl
content/reports/tbr-audit-latest.json
# G23-C cron logs (live-qa / calibration, one file per ISO week; pruned after 8 weeks by crontab.production)
content/reports/logs/*
!content/reports/logs/.gitkeep
