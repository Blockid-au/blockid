# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit populated env files)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.next-backup/
# G30 deployment runtime locators; authoritative origin state is kept separately.
/.g30-candidate.pid
/.g30-candidate-unit

# zero-downtime release dirs (immutable per-build copies the live server runs from)
/releases/
.next-current
.next-previous
/.next-candidate

# Playwright output — never commit trace artefacts.
test-results/
playwright-report/
playwright-report-live-qa/
content/reports/ai-last-report.json
content/reports/ai-provider-status.json
