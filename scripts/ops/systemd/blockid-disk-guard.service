[Unit]
Description=BlockID bounded disk pressure cleanup (80 percent)
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/blockid-maintenance/disk-guard.py --apply --threshold 80 --log-owner-uid 1001 --summary /var/lib/blockid-maintenance/latest.json
User=root
Nice=10
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=256M
TimeoutStartSec=45
SuccessExitStatus=75
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/tmp /var/lib/blockid-maintenance
ProtectHome=read-only
PrivateTmp=false
# L0-4: keep the one-line JSON summary (residual_pressure, action_needed) in
# the journal so scripts/cron/disk-pressure-alert.sh can name the mount when
# it alerts on a failed run. Was StandardOutput=null (silent failures).
StandardOutput=journal
StandardError=journal
